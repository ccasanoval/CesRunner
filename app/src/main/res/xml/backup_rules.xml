<?xml version="1.0" encoding="utf-8"?><!--
   Rules for Android 11 and lower (API <= 30), ignored on API 31+ (see data_extraction_rules.xml).
   See https://developer.android.com/guide/topics/data/autobackup
   The secrets DataStore (SECRETS_DATASTORE_NAME in data/.../prefs/PrefDataStore.kt) holds the
   user's LLM API keys: never back it up.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/CesRunnerSecrets.preferences_pb"/>
</full-backup-content>
